# See https://help.github.com/articles/ignoring-files/

# ----- dependencies -----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----- next.js -----
/.next/
/out/
/build

# ----- env & secrets (never commit) -----
.env*
!.env.example
leaderboard-editor-credentials.txt
csot-registrations-export.csv
*.pem

# ----- supabase local dev -----
.supabase/
.branches/

# ----- testing & coverage -----
/coverage
/playwright-report/
/test-results/

# ----- typescript -----
*.tsbuildinfo
next-env.d.ts

# ----- logs & debug -----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ----- deployment / hosting -----
.vercel

# ----- OS & editor -----
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# Cursor local state (rules/skills live in user config, not the repo)
.cursor/

# ----- misc -----
.turbo
.cache/
