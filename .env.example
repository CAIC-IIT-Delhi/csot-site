# Copy to .env.local and fill in. NEVER commit .env.local.

# ----- Auth.js v5 -----
# Generate with:  npx auth secret
# (Or: openssl rand -base64 32)
AUTH_SECRET=

# Public URL of the app. In dev this is http://localhost:3000.
# In prod set to the production URL, e.g. https://csot.devclub.in
AUTH_URL=http://localhost:3000

# ----- DevClub IITD OAuth -----
# From https://auth.devclub.in developer portal for this client.
# Redirect URI registered: <AUTH_URL>/api/auth/callback/devclub
DEVCLUB_CLIENT_ID=
DEVCLUB_CLIENT_SECRET=

# ----- Supabase -----
# From the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key (secret). Grab from Project Settings → API → Service role.
# This key bypasses RLS, so it must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
